# ── Required API keys ────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key_here      # https://aistudio.google.com
SARVAM_API_KEY=your_sarvam_api_key_here            # https://sarvam.ai
DATA_GOV_API_KEY=your_data.gov.in_api_key_here     # https://data.gov.in (~10 min)

# ── Frontend API base (optional) ──────────────────────────────────
# The React UI is served same-origin by FastAPI, so leave this unset
# locally. When hosting the UI separately (e.g. Vercel), set
# VITE_API_URL=https://your-fastapi-host before `npm run build`.
# VITE_API_URL=http://localhost:8000
